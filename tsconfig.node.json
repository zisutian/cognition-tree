{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "playwright.config.ts",
    "scripts/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "scripts/benchmarkWorkspaceCapacity.ts",
    "scripts/migrateRepositoryV2.ts",
    "scripts/repository-v2/**/*.ts"
  ]
}
