{
  "name": "cognition-tree",
  "private": true,
  "version": "0.1.0",
  "description": "A server-backed cognitive tree note application",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "benchmark:capacity": "node --import tsx tooling/benchmark/workspaceCapacity.ts",
    "clean": "node tooling/build/cleanArtifacts.mjs",
    "clean:build": "node tooling/build/cleanArtifacts.mjs --build",
    "dev": "node infrastructure/server/index.ts --development",
    "server:build": "tsc -p tooling/config/tsconfig.server.json",
    "server:start": "node .artifacts/build/server/infrastructure/server/index.js",
    "build": "pnpm clean:build && tsc && vite build && pnpm verify:bundle && pnpm server:build",
    "check": "tsc --noEmit && tsc -p tooling/config/tsconfig.node.json --noEmit && tsc -p tooling/config/tsconfig.cli.json && tsc -p tooling/config/tsconfig.server.json --noEmit && tsc -p tooling/config/tsconfig.e2e.json --noEmit && tsc -p tooling/config/tsconfig.benchmark.json",
    "hooks:install": "git config core.hooksPath .githooks",
    "test": "vitest run",
    "test:architecture": "vitest run tests/architecture tests/presentation/designContract.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:watch": "vitest",
    "verify:bundle": "node tooling/build/verifyClientBundle.ts",
    "preview": "vite preview",
    "release:package": "node tooling/release/packageRuntime.mjs",
    "release:verify": "node tooling/release/verifyRuntime.mjs",
    "release:install": "node tooling/release/installRuntime.mjs",
    "release:recover": "node tooling/release/recoverInstallation.mjs",
    "release:smoke": "node tooling/release/smokeRuntime.mjs"
  },
  "dependencies": {
    "@openai/codex": "0.148.0",
    "@sinclair/typebox": "0.34.52",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@playwright/test": "^1.61.1",
    "@tanstack/react-virtual": "^3.14.6",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.20.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "d3-force": "^3.0.0",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.6"
  }
}
