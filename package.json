{
  "name": "cognition-tree",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first cognitive tree note application",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "benchmark:capacity": "node --import tsx scripts/benchmarkWorkspaceCapacity.ts",
    "dev": "vite",
    "server": "node infrastructure/server/index.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node dist/runtime/infrastructure/server/index.js",
    "build": "tsc && vite build && pnpm verify:bundle && pnpm server:build",
    "check": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.e2e.json --noEmit && tsc -p tsconfig.benchmark.json",
    "hooks:install": "git config core.hooksPath .githooks",
    "test": "vitest run",
    "test:architecture": "vitest run tests/architecture tests/ui/designContract.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "verify:webdav:live": "CTN_RUN_LIVE_WEBDAV=1 vitest run tests/server/adapters/webdav/webDavLive.test.ts --testTimeout=90000",
    "test:watch": "vitest",
    "server:e2e": "node e2e/support/workspaceServer.ts",
    "verify:bundle": "node scripts/verifyClientBundle.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@tanstack/react-virtual": "^3.14.6",
    "d3-force": "^3.0.0",
    "lucide-react": "^1.16.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.20.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.6"
  }
}
