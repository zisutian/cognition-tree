{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "../..",
    "outDir": "../../.artifacts/build/server",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "../../contracts/**/*.ts",
    "../../core/ctn/**/*.ts",
    "../../core/journal/**/*.ts",
    "../../core/todo/**/*.ts",
    "../../infrastructure/server/**/*.ts",
    "../cli/**/*.ts"
  ]
}
