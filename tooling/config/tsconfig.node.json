{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "@playwright/test"],
    "tsBuildInfoFile": "../../tsconfig.node.tsbuildinfo"
  },
  "include": [
    "../../playwright.config.ts",
    "../build/**/*.ts",
    "../../vite.config.ts"
  ],
  "exclude": ["../benchmark/**/*.ts"]
}
